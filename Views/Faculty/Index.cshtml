@model IEnumerable<ProiectIP.Models.FacultyModel>

<div class="menu-container">
    <h1>Select a Faculty</h1>
    <div class="button-list">
        @foreach (var faculty in Model)
        {
            <a class="menu-button" asp-controller="facultate" asp-action="specializare" asp-route-id="@faculty.Id">
                @faculty.Name
            </a>
        }
    </div>
</div>

<style>
    .menu-container {
        text-align: center;
    }
    .button-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
        align-items: center;
    }

    .menu-button {
        display: inline-block;
        padding: 10px 20px;
        text-decoration: none;
        color: white;
        background-color: #007bff;
        border: none;
        border-radius: 5px;
        text-align: center;
        font-size: 16px;
    }

    .menu-button:hover {
        background-color: #0056b3;
    }
</style>
