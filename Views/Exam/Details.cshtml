@model ProiectIP.Models.ExamModel

<h1>Exam Details</h1>
<p>
    <strong>Exam Name:</strong> @Model.Name <br />
    <strong>Scheduled Date:</strong> @Model.ScheduledDate.ToString("yyyy-MM-dd") <br />
    <strong>Duration:</strong> @Model.Duration <br />
    <strong>Location:</strong> @Model.Location <br />
</p>
<a href="@Url.Action("examen", "grupa", new { groupId = Model.GroupId })">Back to Exams</a>