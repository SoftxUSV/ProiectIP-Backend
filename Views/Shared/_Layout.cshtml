<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Exam Scheduler</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <nav class="sidebar bg-light">
            <ul class="list-unstyled">
                <li>
                    <a asp-controller="Faculty" asp-action="Index">Facultati</a><!--href="Url.Action("Index", "Faculty")">Facultati</a> -->
                </li>
                <li>
                    <a href="#">Grupe</a> <!-- This can lead to specific group logic if needed -->
                </li>
                <li>
                    <a href="#">Examene</a> <!-- This can lead to an exam schedule overview -->
                </li>
                <li>
                    <a href="#">Calendar</a> <!-- Placeholder for calendar -->
                </li>
            </ul>
        </nav>

        <!-- Main Content -->
        <main class="flex-grow-1">
            <div class="container mt-3">
                @RenderBody()
            </div>
        </main>
    </div>

    <style>
        .d-flex {
            display: flex;
            height: 100vh;
        }

        .sidebar {
            width: 250px;
            background-color: #f8f9fa;
            padding: 15px;
        }

            .sidebar ul {
                list-style-type: none;
                padding: 0;
            }

                .sidebar ul li {
                    margin: 10px 0;
                }

                    .sidebar ul li a {
                        text-decoration: none;
                        color: #333;
                        font-size: 18px;
                    }

                        .sidebar ul li a:hover {
                            color: #0056b3;
                        }

        main {
            overflow-y: auto;
        }
    </style>
</body>
</html>